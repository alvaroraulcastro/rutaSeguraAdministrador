# Copia este archivo a .env.local y completa los valores (no commitear .env.local).

POSTGRES_URL="postgresql://usuario:password@localhost:5432/rutasegura"

# Alternativa aceptada por Prisma y el seed:
# DATABASE_URL="postgresql://usuario:password@localhost:5432/rutasegura"

# Panel: vacío = mismo origen que Next (localhost:3000)
# NEXT_PUBLIC_API_URL=

# Notificaciones push (opcional)
# FCM_SERVER_KEY=

# Umbrales GPS en metros (opcional)
# GPS_UMBRAL_EN_CAMINO_METROS=400
# GPS_UMBRAL_EN_PUERTA_METROS=80

# Seed: no borrar tablas si ya hay datos en staging
# PRISMA_SEED_DESTRUCTIVE=false